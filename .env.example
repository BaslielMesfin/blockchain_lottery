# Public frontend configuration
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Provider-approved hosted URL. Supported placeholders: {address}, {chainId}, {amountEth}
NEXT_PUBLIC_ONRAMP_URL_TEMPLATE=

# Sepolia deployment — never expose these as NEXT_PUBLIC variables
SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com
SEPOLIA_PRIVATE_KEY=
HOUSE_ADDRESS=
VRF_COORDINATOR=
VRF_SUBSCRIPTION_ID=
VRF_KEY_HASH=
VRF_CALLBACK_GAS_LIMIT=500000
VRF_TIMEOUT_SECONDS=3600

# Optional monitoring
KEEPER_ADDRESS=
KEEPER_MIN_ETH=0.05
